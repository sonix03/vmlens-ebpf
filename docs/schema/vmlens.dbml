Project "vmlens" {
  database_type: 'PostgreSQL'
  Note: '''
    VMLens tracks network relationships between VMs: who talked to whom, and how
    well that path performed. This is the FULL schema, generated from
    backend/internal/db/migrations by make schema-dbml. Do not hand-edit.

    Colour legend, one per evidence source:
      blue   identity   - what we know the fleet is (agent registration + inventory file)
      teal   observed   - what eBPF actually saw on the NIC
      orange reachable  - what an active probe proved right now
      grey   declared   - tables that exist but no code writes; empty is not "nothing configured"

    Two traps the diagram cannot show:
      network_flows counters are cumulative; flow_observations rows are window deltas.
      network_flows.src_ip is always the observing VM, never the packet header source.
  '''
}

// ======================================================================
// Enums, promoted from CHECK constraints
// ======================================================================

Enum "config_state" {
  "unknown"
  "allowed"
  "denied"
  "blocked"
  "missing"
  "stale"
}

Enum "direction" {
  "ingress"
  "egress"
}

Enum "exposure" {
  "private"
  "public"
  "management"
  "unknown"
}

Enum "flow_scope" {
  "internal_same_tenant"
  "internal_cross_tenant"
  "unknown_internal"
  "external_public"
  "external_private"
  "unknown"
}

Enum "intent_status" {
  "intended"
  "validated"
  "inactive"
  "deprecated"
  "blocked"
}

Enum "node_status" {
  "online"
  "stale"
  "offline"
}

Enum "policy_action" {
  "allow"
  "deny"
  "reject"
}

Enum "protocol" {
  "tcp"
  "udp"
  "icmp"
}

Enum "protocol_or_any" {
  "tcp"
  "udp"
  "icmp"
  "any"
}

Enum "public_ip_status" {
  "assigned"
  "available"
  "released"
  "unknown"
}

Enum "route_type" {
  "private"
  "public"
  "default"
  "peering"
  "vpn"
  "unknown"
}

Enum "security_state" {
  "unknown"
  "private"
  "public"
  "management"
  "overexposed"
  "blocked"
}

// ======================================================================
// Identity (agent + inventory)
// ======================================================================

Table "agents" [headercolor: #3498db] {
  "id" text [pk, not null, note: 'Agent-supplied identifier. Upsert key.']
  "vm_id" text
  "hostname" text [not null]
  "machine_id" text [note: 'Strongest re-identification key across agent reinstalls.']
  "os" text
  "kernel" text
  "agent_version" text
  "environment" text
  "status" node_status [not null, default: 'online', note: 'Derived by the status sweep: online <1m, stale <5m, else offline.']
  "first_seen" timestamptz [not null, default: `now()`]
  "last_seen" timestamptz [not null, default: `now()`, note: 'Bumped by heartbeat AND by every accepted flow ingest.']
  "project_id" text

  Indexes {
    last_seen [type: btree, name: "idx_agents_last_seen"]
    machine_id [type: btree, name: "idx_agents_machine_id"]
    vm_id [type: btree, name: "idx_agents_vm_id"]
  }
  Note: 'One row per installed agent process. id is chosen by the agent, not the backend. Written by /api/agents/register and /heartbeat. status is derived by the sweep, never sent by the agent.'
}

Table "vms" [headercolor: #3498db] {
  "id" text [pk, not null]
  "name" text [not null]
  "tenant_id" text [note: 'Drives internal_same_tenant vs internal_cross_tenant. A NULL tenant can never produce a same-tenant flow.']
  "private_ip" inet [note: 'Primary observed address. Used to match the inventory entry.']
  "public_ip" inet
  "mac_address" text
  "host_id" text
  "role" text
  "discovered_by" text [not null, default: 'agent', note: 'Set to agent for self-registered VMs. Only those are eligible for VM_DELETE_AFTER reaping.']
  "agent_id" text
  "machine_id" text
  "status" node_status [not null, default: 'online', note: 'Derived by the status sweep, same windows as agents.status.']
  "first_seen" timestamptz [not null, default: `now()`]
  "last_seen" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "project_id" text
  "region" text
  "zone" text
  "environment" text
  "owner" text
  "network_id" text
  "subnet_id" text
  "host_type" text [note: 'Inventory-assigned host classification.']

  Indexes {
    agent_id [type: btree, name: "idx_vms_agent_id"]
    machine_id [type: btree, name: "idx_vms_machine_id"]
    (tenant_id, project_id, status, last_seen) [type: btree, name: "idx_vms_ownership"]
    private_ip [type: btree, name: "idx_vms_private_ip"]
    public_ip [type: btree, name: "idx_vms_public_ip"]
    status [type: btree, name: "idx_vms_status"]
  }
  Note: 'One row per known VM. Created by agent registration (discovered_by=agent) and enriched from configs/vms.local by IP match. Inventory values win over self-reported ones.'
}

Table "vm_interfaces" [headercolor: #3498db] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "vm_id" text [not null]
  "interface_name" text [not null]
  "ip_address" inet
  "mac_address" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (vm_id, interface_name, ip_address, mac_address) [type: btree, unique, name: "uq_vm_interfaces_identity"]
    ip_address [type: btree, name: "idx_vm_interfaces_ip_address"]
    mac_address [type: btree, name: "idx_vm_interfaces_mac_address"]
    vm_id [type: btree, name: "idx_vm_interfaces_vm_id"]
  }
  Note: 'Every NIC an agent reported. This is the lookup table that turns a peer IP into a VM ID, so an unreported interface makes that path look external. Unique on (vm_id, interface_name, ip_address, mac_address) NULLS NOT DISTINCT.'
}

// ======================================================================
// Observed traffic (eBPF)
// ======================================================================

Table "network_flows" [headercolor: #16a085] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "agent_id" text
  "src_vm_id" text
  "dst_vm_id" text
  "src_ip" inet [not null, note: 'Always the observing VM, never simply the packet header source.']
  "dst_ip" inet [not null, note: 'The peer.']
  "src_port" int4 [note: 'First-seen only. NOT part of the bucket key and not meaningful for display.']
  "dst_port" int4 [note: 'The peer port. On an ingress flow this is the client ephemeral port; resolve service_port for display.']
  "protocol" protocol [not null]
  "direction" direction [not null, default: 'egress', note: 'Which way the bytes moved relative to the observing NIC.']
  "scope" flow_scope [not null, note: 'Part of the bucket key, so a peer that later registers as a VM starts a NEW bucket.']
  "bytes_sent" int8 [not null, default: 0]
  "bytes_received" int8 [not null, default: 0]
  "packets" int8 [not null, default: 0, note: 'TC path only. A kprobe-only flow has bytes and connections but zero packets.']
  "connection_count" int8 [not null, default: 0]
  "first_seen" timestamptz [not null]
  "last_seen" timestamptz [not null]
  "interface_name" text
  "created_at" timestamptz [not null, default: `now()`]
  "observed_at" timestamptz [not null, default: `now()`, note: 'When the control plane last accepted an update. Use this for freshness.']
  "request_count" int8 [not null, default: 0]
  "error_count" int8 [not null, default: 0, note: 'TCP RST count, cumulative.']
  "last_error_at" timestamptz [note: 'NULL until the first non-zero error window arrives.']
  "retransmission_count" int8 [not null, default: 0]
  "avg_rtt_ms" float8 [not null, default: 0, note: 'Kernel TCP RTT, smoothed as (old+new)/2. 0 means no sample, not 0 ms.']
  "avg_app_delay_ms" float8 [not null, default: 0, note: 'Time to first response byte, same smoothing. 0 means no sample.']
  "http_1xx_count" int8 [not null, default: 0]
  "http_2xx_count" int8 [not null, default: 0]
  "http_3xx_count" int8 [not null, default: 0]
  "http_4xx_count" int8 [not null, default: 0]
  "http_5xx_count" int8 [not null, default: 0, note: 'Always 0 for TLS, which is not the same as no errors.']
  "last_http_status" int4 [note: 'Plaintext HTTP/1.x only, derived in-kernel from the status line. No payload is stored.']

  Indexes {
    agent_id [type: btree, name: "idx_network_flows_agent_id"]
    dst_ip [type: btree, name: "idx_network_flows_dst_ip"]
    dst_vm_id [type: btree, name: "idx_network_flows_dst_vm_id"]
    observed_at [type: btree, name: "idx_network_flows_http_5xx"]
    last_error_at [type: btree, name: "idx_network_flows_last_error_at"]
    last_seen [type: btree, name: "idx_network_flows_last_seen"]
    observed_at [type: btree, name: "idx_network_flows_observed_at"]
    protocol [type: btree, name: "idx_network_flows_protocol"]
    scope [type: btree, name: "idx_network_flows_scope"]
    src_ip [type: btree, name: "idx_network_flows_src_ip"]
    src_vm_id [type: btree, name: "idx_network_flows_src_vm_id"]
  }
  Note: 'Aggregate flow state, one row per flow bucket, updated in place. Counters here are CUMULATIVE since first_seen, while the agent posts window deltas. No unique index: the bucket is found by SELECT ... FOR UPDATE on (src_vm_id, dst_vm_id, src_ip, dst_ip, protocol, dst_port, scope, direction) under a pg_advisory_xact_lock. Rows are never deleted.'
}

Table "flow_observations" [headercolor: #16a085] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "flow_id" uuid [not null, note: 'The bucket this window was folded into. CASCADE on delete.']
  "agent_id" text
  "src_vm_id" text
  "dst_vm_id" text
  "src_ip" inet [not null]
  "dst_ip" inet [not null]
  "src_port" int4
  "dst_port" int4
  "protocol" protocol [not null]
  "direction" direction [not null]
  "scope" flow_scope [not null]
  "bytes_sent" int8 [not null, default: 0]
  "bytes_received" int8 [not null, default: 0]
  "packets" int8 [not null, default: 0]
  "connection_count" int8 [not null, default: 0]
  "request_count" int8 [not null, default: 0]
  "first_seen" timestamptz [not null]
  "last_seen" timestamptz [not null]
  "observed_at" timestamptz [not null, default: `now()`, note: 'When the request was accepted. The only time column safe for rate windows.']
  "error_count" int8 [not null, default: 0]
  "retransmission_count" int8 [not null, default: 0]
  "avg_rtt_ms" float8 [not null, default: 0]
  "avg_app_delay_ms" float8 [not null, default: 0]
  "http_1xx_count" int8 [not null, default: 0]
  "http_2xx_count" int8 [not null, default: 0]
  "http_3xx_count" int8 [not null, default: 0]
  "http_4xx_count" int8 [not null, default: 0]
  "http_5xx_count" int8 [not null, default: 0]
  "last_http_status" int4

  Indexes {
    flow_id [type: btree, name: "idx_flow_observations_flow_id"]
    observed_at [type: btree, name: "idx_flow_observations_observed_at"]
    (scope, observed_at) [type: btree, name: "idx_flow_observations_scope_observed_at"]
  }
  Note: 'Append-only event log, one row per accepted ingest request. Counters are the WINDOW DELTA exactly as posted and latency is the raw window average, the opposite semantics of network_flows. Use this for rates and time series. Nothing deletes from this table: it grows one row per bucket per FLOW_INTERVAL (2s) per agent, forever.'
}

Table "external_hosts" [headercolor: #16a085] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "ip" inet [unique, not null]
  "domain" text [note: 'Enrichment column. Nothing populates it today.']
  "asn" text [note: 'Enrichment column. Nothing populates it today.']
  "country" text [note: 'Enrichment column. Nothing populates it today.']
  "provider" text [note: 'Enrichment column. Nothing populates it today.']
  "first_seen" timestamptz [not null, default: `now()`]
  "last_seen" timestamptz [not null, default: `now()`]
  Note: 'Peer registry for public addresses and out-of-inventory private ones. Written on ingest, unique on ip.'
}

Table "unknown_internal_hosts" [headercolor: #16a085] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "ip" inet [unique, not null]
  "first_seen" timestamptz [not null, default: `now()`]
  "last_seen" timestamptz [not null, default: `now()`]
  "resolved_vm_id" text
  Note: 'Private peers inside INTERNAL_CIDRS that are not registered VMs. When an agent later registers with that IP the row gains resolved_vm_id and the affected flows are re-pointed at the VM.'
}

// ======================================================================
// Reachability (active probe)
// ======================================================================

Table "connection_probes" [headercolor: #e67e22] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "agent_id" text [not null]
  "src_vm_id" text [not null]
  "dst_vm_id" text
  "src_ip" inet [not null]
  "dst_ip" inet [not null]
  "protocol" protocol [not null, default: 'tcp']
  "dst_port" int4 [not null, default: 18081]
  "source" text [not null, default: 'vmlens_probe']
  "probe_type" text [not null, default: 'connectivity_check']
  "success" bool [not null, default: false, note: 'Reachable at the probe layer only.']
  "rtt_ms" float8 [not null, default: 0, note: 'Probe wall-clock elapsed time. NOT the kernel TCP RTT in network_flows.avg_rtt_ms.']
  "error" text
  "first_seen" timestamptz [not null, default: `now()`]
  "last_seen" timestamptz [not null, default: `now()`]
  "observed_at" timestamptz [not null, default: `now()`]

  Indexes {
    (agent_id, src_vm_id, dst_vm_id, dst_ip, protocol, dst_port) [type: btree, unique, name: "uq_connection_probes_pair"]
    (success, observed_at) [type: btree, name: "idx_connection_probes_recent"]
    (src_vm_id, observed_at) [type: btree, name: "idx_connection_probes_src_vm"]
  }
  Note: 'Active probe results: CURRENT STATE, NOT HISTORY. The unique index on (agent_id, src_vm_id, dst_vm_id, dst_ip, protocol, dst_port) makes each new result overwrite the previous one, so a flapping path is indistinguishable from a stable one. Feeds graph edges with kind=reachability, which must never be drawn as workload traffic.'
}

// ======================================================================
// Declared only - nothing writes these
// ======================================================================

Table "cloud_public_ips" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "vm_id" text
  "ip_address" inet [not null]
  "provider_id" text [unique]
  "status" public_ip_status [not null, default: 'assigned']
  "assigned_at" timestamptz
  "last_seen_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, project_id, vm_id) [type: btree, name: "idx_cloud_public_ips_ownership"]
  }
  Note: 'DECLARED ONLY: read by /api/cloud/context, written by nothing. The cloud provider is wired to a noop.'
}

Table "cloud_firewall_rules" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "provider_id" text [unique]
  "name" text
  "direction" direction [not null]
  "protocol" protocol_or_any [not null, default: 'tcp']
  "port_min" int4
  "port_max" int4
  "source_cidr" cidr
  "dest_cidr" cidr
  "source_vm_id" text
  "dest_vm_id" text
  "action" policy_action [not null, default: 'allow']
  "scope" exposure [not null, default: 'private']
  "description" text
  "last_synced_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, project_id, source_vm_id, dest_vm_id) [type: btree, name: "idx_cloud_firewall_rules_ownership"]
  }
  Note: 'DECLARED ONLY: read by /api/cloud/context, written by nothing. Empty does not mean nothing is configured, it means nothing has been synced.'
}

Table "cloud_routes" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "provider_id" text [unique]
  "network_id" text
  "subnet_id" text
  "destination" cidr [not null]
  "next_hop" inet
  "route_type" route_type [not null, default: 'private']
  "description" text
  "last_synced_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, project_id, network_id, subnet_id) [type: btree, name: "idx_cloud_routes_ownership"]
  }
  Note: 'DECLARED ONLY: read by /api/cloud/context, written by nothing.'
}

Table "cloud_network_policies" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "name" text [not null]
  "zone" text
  "source_vm_id" text
  "dest_vm_id" text
  "protocol" protocol_or_any
  "port" int4
  "action" policy_action [not null, default: 'allow']
  "description" text
  "last_synced_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, project_id, source_vm_id, dest_vm_id) [type: btree, name: "idx_cloud_network_policies_ownership"]
  }
  Note: 'DECLARED ONLY: read by /api/cloud/context, written by nothing.'
}

Table "connection_intents" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "source_vm_id" text [not null]
  "dest_vm_id" text [not null]
  "protocol" protocol_or_any [not null, default: 'tcp']
  "port" int4 [not null, default: 0]
  "purpose" text
  "exposure" exposure [not null, default: 'private']
  "required" bool [not null, default: true]
  "status" intent_status [not null, default: 'intended']
  "created_by" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (source_vm_id, dest_vm_id, protocol, port, exposure) [type: btree, unique, name: "uq_connection_intents_identity"]
    (tenant_id, project_id, source_vm_id, dest_vm_id) [type: btree, name: "idx_connection_intents_ownership"]
  }
  Note: 'DECLARED ONLY: read by the connection state service, written by nothing. Intended to hold what a path is supposed to be.'
}

Table "connection_configurations" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "intent_id" uuid
  "source_vm_id" text [not null]
  "dest_vm_id" text [not null]
  "protocol" protocol_or_any [not null, default: 'tcp']
  "port" int4 [not null, default: 0]
  "firewall_rule_id" uuid
  "route_id" uuid
  "network_id" text
  "config_state" config_state [not null, default: 'unknown']
  "security_state" security_state [not null, default: 'unknown']
  "last_synced_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (source_vm_id, dest_vm_id, protocol, port, `COALESCE(network_id, ''::text)`) [type: btree, unique, name: "uq_connection_configurations_identity"]
    (tenant_id, project_id, source_vm_id, dest_vm_id) [type: btree, name: "idx_connection_configurations_ownership"]
  }
  Note: 'DECLARED ONLY: read by the connection state service, written by nothing. Intended to link an intent to a firewall rule and a route.'
}

Table "connection_change_events" [headercolor: #95a5a6] {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tenant_id" text
  "project_id" text
  "connection_id" uuid
  "change_type" text [not null]
  "actor" text
  "before_state" jsonb
  "after_state" jsonb
  "affected_source_vm_id" text
  "affected_dest_vm_id" text
  "validation_state" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, project_id, created_at) [type: btree, name: "idx_connection_change_events_ownership"]
  }
  Note: 'DECLARED ONLY: no reader and no writer anywhere in the codebase.'
}

// ======================================================================
// Groups
// ======================================================================

TableGroup "Identity (agent + inventory)" {
  agents
  vms
  vm_interfaces
}

TableGroup "Observed traffic (eBPF)" {
  network_flows
  flow_observations
  external_hosts
  unknown_internal_hosts
}

TableGroup "Reachability (active probe)" {
  connection_probes
}

TableGroup "Declared only - nothing writes these" {
  cloud_public_ips
  cloud_firewall_rules
  cloud_routes
  cloud_network_policies
  connection_intents
  connection_configurations
  connection_change_events
}

// ======================================================================
// Relations
// ======================================================================

Ref "cloud_firewall_rules_dest_vm_id_fkey":"vms"."id" ?<? "cloud_firewall_rules"."dest_vm_id" [delete: set null]
Ref "cloud_firewall_rules_source_vm_id_fkey":"vms"."id" ?<? "cloud_firewall_rules"."source_vm_id" [delete: set null]
Ref "cloud_network_policies_dest_vm_id_fkey":"vms"."id" ?<? "cloud_network_policies"."dest_vm_id" [delete: set null]
Ref "cloud_network_policies_source_vm_id_fkey":"vms"."id" ?<? "cloud_network_policies"."source_vm_id" [delete: set null]
Ref "cloud_public_ips_vm_id_fkey":"vms"."id" ?<? "cloud_public_ips"."vm_id" [delete: set null]
Ref "connection_change_events_affected_dest_vm_id_fkey":"vms"."id" ?<? "connection_change_events"."affected_dest_vm_id" [delete: set null]
Ref "connection_change_events_affected_source_vm_id_fkey":"vms"."id" ?<? "connection_change_events"."affected_source_vm_id" [delete: set null]
Ref "connection_configurations_dest_vm_id_fkey":"vms"."id" <? "connection_configurations"."dest_vm_id" [delete: cascade]
Ref "connection_configurations_firewall_rule_id_fkey":"cloud_firewall_rules"."id" ?<? "connection_configurations"."firewall_rule_id" [delete: set null]
Ref "connection_configurations_intent_id_fkey":"connection_intents"."id" ?<? "connection_configurations"."intent_id" [delete: set null]
Ref "connection_configurations_route_id_fkey":"cloud_routes"."id" ?<? "connection_configurations"."route_id" [delete: set null]
Ref "connection_configurations_source_vm_id_fkey":"vms"."id" <? "connection_configurations"."source_vm_id" [delete: cascade]
